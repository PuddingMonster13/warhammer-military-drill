-- Units Pass Through, version --VERSION-- TEST BUILD (!units_pass_through_debug.pack).
-- When a model walks into a model of ANOTHER FRIENDLY UNIT that stands idle (not moving, not in melee, not
-- shooting, not routing), the standing model gives way: it takes nearly the whole push and the walker is not
-- marked "blocked", and the standing models next to the walker play a step animation away from it (the game's
-- own STEP_LEFT / RIGHT / BACKWARD / FORWARD). Works for every army in the battle, the AI's too.
-- Needs memreader Plus. If anything does not match this game build, the mod does nothing.
-- Test build: it writes units_pass_through_log.txt in the game folder.

local MOD = 'units_pass_through'
local LOG_FILE = 'units_pass_through_log.txt'
local TIMER = MOD .. '_tick'
local TICK_MS = 200
local COLLECT_EVERY = 50 -- ticks (10 s): look for new units (reinforcements, summons)
local REPORT_EVERY = 25 -- ticks (5 s)
local NAMES_EVERY = 150 -- ticks (30 s)
local SHOT_TICKS = 25 -- a unit that used ammunition in the last 5 s counts as shooting
local STEP_ANIMATION = true -- false: models are only shoved aside, no step animation

-- generated by mod.py (do not edit by hand) -------------------------------------------------------------------------
local SITES = {
--SITES--
}
local EXTRA = {
--EXTRA--
}
local HEAD = '--HEAD--'
local TABLE_SIZE = --TABLE_SIZE--
local ENABLE, STEP_ON, CHANCE = --ENABLE--, --STEP_ON--, --CHANCE--
local K_SMALL, K_BIG, MAX_K, MIN_K = --K_SMALL--, --K_BIG--, --MAX_K--, --MIN_K--
local K_SMALL_BITS, K_BIG_BITS, MAX_K_BITS, MIN_K_BITS, CHANCE_BITS = --K_SMALL_BITS--, --K_BIG_BITS--, --MAX_K_BITS--, --MIN_K_BITS--, --CHANCE_BITS--
local K_TEXT = '--K_TEXT--'
local C_B_GIVES, C_A_GIVES, C_FREE_1, C_FREE_2, C_STEPS, C_TOUCH = --C_B_GIVES--, --C_A_GIVES--, --C_FREE_1--, --C_FREE_2--, --C_STEPS--, --C_TOUCH--
local STEP_MASK, STEP_MASK_VALUE = --STEP_MASK--, --STEP_MASK_VALUE--
local LIST, MAX_UNITS = --LIST--, --MAX_UNITS--
local REMAP, STEP_SLOTS = --REMAP--, { --STEP_SLOTS-- }
local FLINCH_HI, FLINCH_LO = --FLINCH_HI--, --FLINCH_LO--
local P_UID = '--P_UID--'
local UID_OFF = --UID_OFF--
-- end of generated part -------------------------------------------------------------------------------------------

local NEEDED = { 'find_pattern', 'hook_info', 'code_cave', 'game_alloc', 'alloc', 'read', 'read_original', 'write', 'read_pointer', 'read_uint32', 'ud_topointer', 'add', 'is_null', 'tostring', 'uint32' }
local ZERO8 = '\0\0\0\0\0\0\0\0'
local sub = string.sub_lua or string.sub -- the game replaces string.sub with a UTF-8 version
local COUNTERS = { { 'standing model gave way (second of the pair)', C_B_GIVES }, { 'standing model gave way (first of the pair)', C_A_GIVES }, { 'walker not blocked (place 1)', C_FREE_1 }, { 'walker not blocked (place 2)', C_FREE_2 }, { 'walker touched a standing model', C_TOUCH }, { 'step animation asked for', C_STEPS } }

local mr = nil
local state = { dead = false, tbl = nil, uid_offset = nil, buffer = nil, started = false, units = {}, ticks = 0, fighting = false, listed = 0, last = {}, totals = {}, cost = 0, longest = 0 }

local function log(message)
	local file = io.open(LOG_FILE, state.started and 'a' or 'w')
	state.started = true
	if not file then return end
	file:write(os.date('%H:%M:%S') .. ' ' .. tostring(message) .. '\n')
	file:close()
end

-- switch the caves off: they then leave the game exactly as it is
local function switch_off()
	if not state.tbl then return end
	mr.write(state.tbl, ENABLE, mr.uint32(0))
	mr.write(state.tbl, STEP_ON, mr.uint32(0))
	mr.write(state.tbl, LIST, ZERO8)
end

local function give_up(reason)
	state.dead = true
	pcall(switch_off)
	log('MOD OFF: ' .. tostring(reason))
end

local function raw8(pointer)
	state.buffer = state.buffer or mr.alloc(16)
	mr.write(state.buffer, 0, pointer)
	return mr.read(state.buffer, 0, 8)
end

local function hex(pointer)
	return mr.tostring(pointer)
end

local function game_address(hi, lo)
	return mr.add(mr.add(mr.base, hi * 65536), lo)
end

-- installing ------------------------------------------------------------------------------------------------------

local function install()
	for _, name in ipairs(NEEDED) do
		if type(mr[name]) ~= 'function' then error('this memreader has no ' .. name, 0) end
	end
	if not mr.base then error('this memreader does not tell where the game is loaded', 0) end
	local address, count = mr.find_pattern(P_UID)
	if not address or count ~= 1 then error('unit id code found ' .. tostring(count) .. ' times', 0) end
	state.uid_offset = mr.read_uint32(mr.add(address, UID_OFF), 0)
	if type(state.uid_offset) ~= 'number' or state.uid_offset < 8 or state.uid_offset > 0x100000 then error('implausible unit id offset', 0) end

	-- every site must hold exactly the bytes of the analysed game build, otherwise nothing is installed at all
	for _, site in ipairs(SITES) do
		site.at = game_address(site.hi, site.lo)
		if mr.read_original(site.at, 0, #site.sig) ~= site.sig then error('this game build is not the analysed one (' .. site.name .. ')', 0) end
	end
	for _, extra in ipairs(EXTRA) do
		if mr.read_original(game_address(extra.hi, extra.lo), 0, #extra.sig) ~= extra.sig then error('this game build is not the analysed one (' .. extra.name .. ')', 0) end
	end
	-- caves of an earlier battle of this game session are still there: then they hold the table address
	local found = 0
	for _, site in ipairs(SITES) do
		local info = mr.hook_info(site.at)
		if info then
			if info.kind ~= 'cave' or not info.cave then error('something else hooks ' .. site.name, 0) end
			local tbl = mr.read_pointer(info.cave, #HEAD)
			if mr.is_null(tbl) then error('cave without a table at ' .. site.name, 0) end
			if state.tbl and hex(state.tbl) ~= hex(tbl) then error('caves with different tables: remove other test packs and restart the game', 0) end
			state.tbl = tbl
			site.cave = info.cave
			found = found + 1
		end
	end
	if found > 0 and found < #SITES then error('only some caves of an earlier battle are there (probe pack still on, or an older build): restart the game', 0) end
	if found == 0 then state.tbl = mr.game_alloc(TABLE_SIZE) end -- zeroed = switched off; never freed, the caves stay for the game session
	-- the cave code with the addresses filled in: where it leaves to, the routine it calls, the table
	local function put(code, at, pointer)
		if at < 0 then return code end
		return sub(code, 1, at) .. raw8(pointer) .. sub(code, at + 9)
	end
	for _, site in ipairs(SITES) do
		local code = put(site.tail, site.exit_at, game_address(site.exit_hi, site.exit_lo))
		code = put(code, site.call_at, game_address(FLINCH_HI, FLINCH_LO))
		site.code = put(code, site.table_at, state.tbl)
		if #site.code ~= #site.tail then error('cave code of the wrong length', 0) end
		if site.cave then
			if mr.read(site.cave, #HEAD + 8, #site.code) ~= site.code then error('the cave at ' .. site.name .. ' is not this version\'s (probe pack still on, or an older build): remove it and restart the game', 0) end
			site.installed = true
		end
	end
	if found > 0 then log('caves of an earlier battle of this session found, reusing them') end
	switch_off()
	mr.write(state.tbl, K_SMALL, mr.uint32(K_SMALL_BITS))
	mr.write(state.tbl, K_BIG, mr.uint32(K_BIG_BITS))
	mr.write(state.tbl, MAX_K, mr.uint32(MAX_K_BITS))
	mr.write(state.tbl, MIN_K, mr.uint32(MIN_K_BITS))
	mr.write(state.tbl, CHANCE, mr.uint32(STEP_ANIMATION and CHANCE_BITS or 0))
	mr.write(state.tbl, STEP_MASK, mr.uint32(STEP_MASK_VALUE))
	for index, slot in ipairs(STEP_SLOTS) do mr.write(state.tbl, REMAP + 4 * (index - 1), mr.uint32(slot)) end
	if mr.read_uint32(state.tbl, K_SMALL) ~= K_SMALL_BITS or mr.read_uint32(state.tbl, MIN_K) ~= MIN_K_BITS or mr.read_uint32(state.tbl, ENABLE) ~= 0
		or mr.read_uint32(state.tbl, REMAP + 4 * (#STEP_SLOTS - 1)) ~= STEP_SLOTS[#STEP_SLOTS] then error('the table does not hold what was written', 0) end
	-- all caves or none: with only a part of them the game would behave in a way nobody has looked at
	for _, site in ipairs(SITES) do
		if not site.installed then
			local ok, problem = pcall(mr.code_cave, site.at, HEAD .. raw8(state.tbl) .. site.code)
			log(('site %-16s %s'):format(site.name, ok and 'cave installed' or ('NOT installed: ' .. tostring(problem))))
			if not ok then error('memreader refused a cave; the mod stays off (caves already placed do nothing while it is off)', 0) end
			site.installed = true
		end
	end
	for _, counter in ipairs(COUNTERS) do state.last[counter[2]] = mr.read_uint32(state.tbl, counter[2]) end
end

-- units -------------------------------------------------------------------------------------------------------------

local function unit_pointer(unit)
	local pointer = mr.read_pointer(mr.ud_topointer(unit), 8)
	if mr.is_null(pointer) or mr.read_uint32(pointer, state.uid_offset) ~= unit:unique_ui_id() then return nil end
	return pointer
end

-- every unit of the battle whose game object is confirmed through its id; what was known about a unit is kept
local function collect_units()
	local units, known = {}, {}
	for _, entry in ipairs(state.units) do known[entry.key] = entry end
	local alliances = bm.battle:alliances()
	for a = 1, alliances:count() do
		local armies = alliances:item(a):armies()
		for b = 1, armies:count() do
			local list = armies:item(b):units()
			for index = 1, list:count() do
				local unit = list:item(index)
				local ok, pointer = pcall(unit_pointer, unit)
				if ok and pointer then
					local key = hex(pointer)
					local entry = known[key] or { key = key, shot_at = -1000 }
					entry.unit, entry.pointer, entry.label = unit, pointer, ('A%d.%d.%d %s'):format(a, b, index, tostring(unit:type()))
					units[#units + 1] = entry
				end
			end
		end
	end
	state.units = units
end

-- does this unit give way now? Standing idle: not moving, not in melee, not routing, not shooting
local function gives_way(entry)
	local unit = entry.unit
	local ammo = unit:ammo_left()
	if type(ammo) == 'number' then
		if entry.ammo and ammo < entry.ammo then entry.shot_at = state.ticks end
		entry.ammo = ammo
	end
	if unit:is_moving() or unit:is_in_melee() or unit:is_routing() or not unit:is_idle() then return false end
	return state.ticks - entry.shot_at > SHOT_TICKS
end

-- writes the list the caves read. They only compare pointers, so a half-written list cannot hurt: at worst one
-- unit is treated the old way for a moment
local function publish()
	local count = 0
	for _, entry in ipairs(state.units) do
		entry.gives = gives_way(entry)
		if entry.gives and count < MAX_UNITS then
			mr.write(state.tbl, LIST + 8 * count, entry.pointer)
			count = count + 1
		end
	end
	mr.write(state.tbl, LIST + 8 * count, ZERO8)
	state.listed = count
end

-- reports (test build) ------------------------------------------------------------------------------------------------

local function report()
	local parts = {}
	for _, counter in ipairs(COUNTERS) do
		local count = mr.read_uint32(state.tbl, counter[2])
		local delta = count - (state.last[counter[2]] or 0)
		if delta < 0 then delta = delta + 4294967296 end
		state.last[counter[2]] = count
		state.totals[counter[1]] = (state.totals[counter[1]] or 0) + delta
		if delta ~= 0 then parts[#parts + 1] = ('%s +%d'):format(counter[1], delta) end
	end
	if #parts > 0 then log(('%d of %d units give way | %s'):format(state.listed, #state.units, table.concat(parts, '; '))) end
end

local function names_report()
	local standing = {}
	for _, entry in ipairs(state.units) do
		if entry.gives then standing[#standing + 1] = entry.label end
	end
	log(('units that give way now (%d of %d): %s'):format(#standing, #state.units, #standing > 0 and table.concat(standing, ', ') or 'none'))
	log(('script cost: %.2f ms per tick on average, longest %.1f ms'):format(state.cost * 1000 / NAMES_EVERY, state.longest * 1000))
	state.cost, state.longest = 0, 0
end

local function totals_report()
	local parts = {}
	for _, counter in ipairs(COUNTERS) do parts[#parts + 1] = ('%s %d'):format(counter[1], state.totals[counter[1]] or 0) end
	log('totals of this battle: ' .. table.concat(parts, '; '))
end

-- start -----------------------------------------------------------------------------------------------------------

local function guarded(name, action)
	return function()
		if state.dead then return end
		local ok, problem = pcall(action)
		if not ok then
			give_up(name .. ': ' .. tostring(problem))
			pcall(function() bm:remove_callback(TIMER) end)
		end
	end
end

local function start()
	log('Units Pass Through --VERSION-- TEST BUILD, battle script loaded')
	mr = _G.memreader_plus
	if not mr then error('memreader Plus is not loaded', 0) end
	install()
	log(('memreader Plus %s, table at %s, unit id offset 0x%x; %s'):format(tostring(mr.plus_version), hex(state.tbl), state.uid_offset, K_TEXT))
	bm:register_phase_change_callback('Deployed', guarded('deployed', function()
		collect_units()
		publish()
		mr.write(state.tbl, ENABLE, mr.uint32(1))
		state.fighting = true
		log(('fighting starts, mod ON: %d units'):format(#state.units))
		names_report()
	end))
	bm:repeat_callback(guarded('tick', function()
		if not state.fighting then return end
		local started = os.clock()
		state.ticks = state.ticks + 1
		if state.ticks % COLLECT_EVERY == 0 then collect_units() end
		publish()
		local took = os.clock() - started
		state.cost = state.cost + took
		if took > state.longest then state.longest = took end
		if state.ticks % REPORT_EVERY == 0 then report() end
		if state.ticks % NAMES_EVERY == 0 then names_report() end
	end), TICK_MS, TIMER)
	bm:register_phase_change_callback('Complete', function()
		if state.dead then return end
		state.dead = true
		pcall(switch_off)
		pcall(function() bm:remove_callback(TIMER) end)
		pcall(report)
		pcall(totals_report)
		log('battle complete, mod off')
	end)
end

local ok, problem = pcall(start)
if not ok then give_up(problem) end
