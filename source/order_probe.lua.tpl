-- Units Pass Through "order probe", version --VERSION--: test pack (!units_order_probe_debug.pack).
-- Question: does a standing model keep an "order" object with its place, and does it walk to a changed place?
-- By itself, in the first 25 s of the fighting (the player's units must just STAND):
--    3 s  picks six models of standing units of the player's side and looks for their order objects
--    8 s  changes the place in the orders it found by 2.5 m (models without an order are moved 4 m instead)
--   16 s  puts the places back
--   24 s  "PROBE FINISHED". Needs memreader Plus. Log: units_order_probe_log.txt in the game folder.

local MOD = 'units_order_probe'
local LOG_FILE = 'units_order_probe_log.txt'
local TIMER = MOD .. '_tick'
local TICK_MS = 200
local T_PICK, T_REPORT, T_EDIT, T_RESTORE, T_END = 15, 30, 40, 80, 120 -- ticks after the fighting starts
local EDIT, SHIFT = 2.5, 4.0 -- metres
local MAX_UNITS = 2
local MAX_PER_TICK = 1500 -- ring entries looked at per tick

-- generated by order_probe.py (do not edit by hand) -----------------------------------------------------------------
local SITE = { name = 'order_step', hi = --HI--, lo = --LO--, sig = '--SIG--', tail = '--TAIL--' }
local HEAD = '--HEAD--'
local TABLE_SIZE = --TABLE_SIZE--
local INDEX, RING_AT, RING, ENTRY = --INDEX--, --RING_AT--, --RING--, --ENTRY--
local VT_HI, VT_LO = --VT_HI--, --VT_LO--
local P_UID = '--P_UID--'
local UID_OFF = --UID_OFF--
-- end of generated part -------------------------------------------------------------------------------------------

local NEEDED = { 'find_pattern', 'hook_info', 'code_cave', 'game_alloc', 'alloc', 'read', 'read_original', 'write', 'read_pointer', 'read_uint32', 'read_float', 'ud_topointer', 'add', 'is_null', 'tostring', 'uint32' }

local mr = nil
local state = { dead = false, tbl = nil, uid_offset = nil, buffer = nil, started = false, ticks = nil, seen = 0, vtable = nil, subjects = {}, by_model = {},
	orders = {}, known = 0, steps = 0, looked = 0, callers = {}, lost = 0 }

local function log(message)
	local file = io.open(LOG_FILE, state.started and 'a' or 'w')
	state.started = true
	if not file then return end
	file:write(os.date('%H:%M:%S') .. ' ' .. tostring(message) .. '\n')
	file:close()
end

local function give_up(reason)
	state.dead = true
	log('PROBE OFF: ' .. tostring(reason))
end

local function raw8(pointer)
	state.buffer = state.buffer or mr.alloc(16)
	mr.write(state.buffer, 0, pointer)
	return mr.read(state.buffer, 0, 8)
end

local function hex(pointer)
	return mr.tostring(pointer)
end

local function float_bits(x)
	if type(x) ~= 'number' or not (x > -1000000 and x < 1000000) then error('not a usable number: ' .. tostring(x), 0) end
	if x == 0 then return 0 end
	local sign = 0
	if x < 0 then sign, x = 2147483648, -x end
	local m, e = math.frexp(x)
	local exponent = e + 126
	local fraction = math.floor((m * 2 - 1) * 8388608 + 0.5)
	if fraction == 8388608 then fraction, exponent = 0, exponent + 1 end
	if exponent < 1 or exponent > 254 or fraction % 1 ~= 0 or fraction < 0 or fraction > 8388607 then error('not a usable number: ' .. tostring(x), 0) end
	return sign + exponent * 8388608 + fraction
end

-- a float of the game, or nil when the 4 bytes are not an ordinary number
local function get_float(pointer, offset)
	local exponent = math.floor(mr.read_uint32(pointer, offset) / 8388608) % 256
	if exponent == 255 then return nil end
	return mr.read_float(pointer, offset)
end

-- installing ------------------------------------------------------------------------------------------------------

local function install()
	for _, name in ipairs(NEEDED) do
		if type(mr[name]) ~= 'function' then error('this memreader has no ' .. name, 0) end
	end
	if not mr.base then error('this memreader does not tell where the game is loaded', 0) end
	local address, count = mr.find_pattern(P_UID)
	if not address or count ~= 1 then error('unit id code found ' .. tostring(count) .. ' times', 0) end
	state.uid_offset = mr.read_uint32(mr.add(address, UID_OFF), 0)
	if type(state.uid_offset) ~= 'number' or state.uid_offset < 8 or state.uid_offset > 0x100000 then error('implausible unit id offset', 0) end
	if float_bits(1) ~= 1065353216 or float_bits(-2.5) ~= 3223322624 then error('float conversion is wrong', 0) end
	state.vtable = hex(mr.add(mr.add(mr.base, VT_HI * 65536), VT_LO))
	SITE.at = mr.add(mr.add(mr.base, SITE.hi * 65536), SITE.lo)
	if mr.read_original(SITE.at, 0, #SITE.sig) ~= SITE.sig then error('this game build is not the analysed one', 0) end
	local info = mr.hook_info(SITE.at)
	if info then
		if info.kind ~= 'cave' or not info.cave then error('something else hooks the routine', 0) end
		if mr.read(info.cave, #HEAD + 8, #SITE.tail) ~= SITE.tail then error('a cave of another version is in place: restart the game', 0) end
		state.tbl = mr.read_pointer(info.cave, #HEAD)
		if mr.is_null(state.tbl) then error('cave without a table', 0) end
		log('cave of an earlier battle of this session found, reusing it')
	else
		state.tbl = mr.game_alloc(TABLE_SIZE)
		local ok, problem = pcall(mr.code_cave, SITE.at, HEAD .. raw8(state.tbl) .. SITE.tail)
		if not ok then error('memreader refused the cave: ' .. tostring(problem), 0) end
		log('cave installed')
	end
	state.seen = mr.read_uint32(state.tbl, INDEX)
end

-- units, models, orders ---------------------------------------------------------------------------------------------

local function unit_pointer(unit)
	local pointer = mr.read_pointer(mr.ud_topointer(unit), 8)
	if mr.is_null(pointer) or mr.read_uint32(pointer, state.uid_offset) ~= unit:unique_ui_id() then return nil end
	return pointer
end

local function position(model)
	return get_float(model, 0x88), get_float(model, 0x8c), get_float(model, 0x90)
end

local function pick_subjects()
	local armies = bm.battle:alliances():item(1):armies()
	for b = 1, armies:count() do
		local list = armies:item(b):units()
		for index = 1, list:count() do
			local unit = list:item(index)
			local ok, pointer = pcall(unit_pointer, unit)
			if ok and pointer and #state.subjects < MAX_UNITS * 3 then
				local count = mr.read_uint32(pointer, 0xa4)
				local models = mr.read_pointer(pointer, 0xa8)
				local label = ('A1.%d.%d %s'):format(b, index, tostring(unit:type()))
				if count >= 20 and count <= 2000 and not mr.is_null(models) and unit:is_idle() and not unit:is_moving() then
					local first = mr.read_pointer(models, 0)
					if mr.read_uint32(first, 0x74) == 1 and hex(mr.read_pointer(first, 0x2e8)) == hex(pointer) then
						for _, place in ipairs({ 0, math.floor(count / 2), count - 1 }) do
							local model = mr.read_pointer(models, 8 * place)
							local x, y, z = position(model)
							if x and y and z then
								local subject = { model = model, key = hex(model), label = ('%s model %d'):format(label, place), x = x, y = y, z = z }
								state.subjects[#state.subjects + 1] = subject
								state.by_model[subject.key] = subject
							end
						end
						log(('subject unit: %s, %d models'):format(label, count))
					end
				end
			end
		end
	end
	if #state.subjects == 0 then error('no standing unit of 20 or more foot models on the first side', 0) end
end

-- the model an order belongs to (as text), or nil when the object is not an order (any more)
local function model_of(order)
	local ok, model = pcall(function()
		if hex(mr.read_pointer(order, 0)) ~= state.vtable then return nil end
		local holder = mr.read_pointer(order, 0x10)
		if mr.is_null(holder) then return nil end
		return hex(mr.read_pointer(holder, 8))
	end)
	return ok and model or nil
end

local function order_text(order)
	local ok, text = pcall(function()
		local x, y, z = get_float(order, 0x40), get_float(order, 0x44), get_float(order, 0x48)
		local tick = '?'
		pcall(function() tick = tostring(mr.read_uint32(mr.read_pointer(mr.read_pointer(order, 0x30), 0x440), 0x98)) end)
		return ('place %s %s %s, hangs on %s, kind %d, state %d, flags %02x, sent %d, waits for tick %d (battle tick now %s)'):format(
			x and ('%.2f'):format(x) or '?', y and ('%.2f'):format(y) or '?', z and ('%.2f'):format(z) or '?', hex(mr.read_pointer(order, 0x58)),
			mr.read_uint32(order, 0x74), mr.read_uint32(order, 0x78), mr.read_uint32(order, 0x90) % 256, mr.read_uint32(order, 0x9c) % 256, mr.read_uint32(order, 0xa0), tick)
	end)
	return ok and text or ('unreadable: ' .. tostring(text))
end

-- new entries of the ring: which orders are stepped, and which of them belong to the subject models
local function read_ring()
	local now = mr.read_uint32(state.tbl, INDEX)
	local new = now - state.seen
	if new < 0 then new = new + 4294967296 end
	state.steps = state.steps + new
	if new > RING then new = RING end
	if new > MAX_PER_TICK then
		state.lost = state.lost + (new - MAX_PER_TICK)
		new = MAX_PER_TICK
	end
	for n = now - new, now - 1 do
		local at = RING_AT + (n % RING) * ENTRY
		local order = mr.read_pointer(state.tbl, at)
		local key = hex(order)
		state.looked = state.looked + 1
		if state.orders[key] == nil then
			local model = model_of(order)
			state.orders[key] = model or false
			state.known = state.known + 1
			local caller = hex(mr.read_pointer(state.tbl, at + 8))
			state.callers[caller] = (state.callers[caller] or 0) + 1
			local subject = model and state.by_model[model]
			if subject and not subject.order then
				subject.order = order
				log(('ORDER of %s found at %s: %s'):format(subject.label, key, order_text(order)))
			end
		end
	end
	state.seen = now
end

local function histogram(counts)
	local rows = {}
	for text, count in pairs(counts) do rows[#rows + 1] = { text = text, count = count } end
	table.sort(rows, function(a, b) return a.count > b.count end)
	local parts = {}
	for index = 1, math.min(#rows, 8) do parts[#parts + 1] = rows[index].text .. ' x' .. rows[index].count end
	return #parts > 0 and table.concat(parts, ', ') or 'none'
end

local function report(title)
	local with_order = 0
	for _, subject in ipairs(state.subjects) do
		if subject.order then with_order = with_order + 1 end
	end
	log(('%s the step routine ran %d times; %d different objects seen so far (callers of their first step: %s); ring entries not looked at: %d; subject models with an order: %d of %d'):format(
		title, state.steps, state.known, histogram(state.callers), state.lost, with_order, #state.subjects))
	state.steps, state.lost = 0, 0
end

local function follow(title)
	for _, subject in ipairs(state.subjects) do
		local x, _, z = position(subject.model)
		local far = (x and z) and ('%.2f'):format(math.sqrt((x - subject.x) ^ 2 + (z - subject.z) ^ 2)) or '?'
		local order = '-'
		if subject.order then
			order = (model_of(subject.order) == subject.key) and order_text(subject.order) or 'the object is no longer this model\'s order'
		end
		log(('  %s %s: %s m from where it stood | order: %s'):format(title, subject.label, far, order))
	end
end

local function edit()
	for _, subject in ipairs(state.subjects) do
		if subject.order and model_of(subject.order) == subject.key then
			local x = get_float(subject.order, 0x40)
			if x and mr.is_null(mr.read_pointer(subject.order, 0x58)) then
				subject.old = x
				mr.write(subject.order, 0x40, mr.uint32(float_bits(x + EDIT)))
				mr.write(subject.order, 0xa0, mr.uint32(0))
				log(('EDITED the order of %s: place x %.2f -> %.2f, wait cleared'):format(subject.label, x, x + EDIT))
			else
				log(('order of %s not edited (place unreadable or hanging on an object)'):format(subject.label))
			end
		else
			mr.write(subject.model, 0x88, mr.uint32(float_bits(subject.x + SHIFT)))
			subject.moved = true
			log(('%s has no order object: MOVED the model %.1f m instead'):format(subject.label, SHIFT))
		end
	end
end

local function restore()
	for _, subject in ipairs(state.subjects) do
		if subject.old then
			local x = (model_of(subject.order) == subject.key) and get_float(subject.order, 0x40) or nil
			if x and math.abs(x - (subject.old + EDIT)) < 0.01 then
				mr.write(subject.order, 0x40, mr.uint32(float_bits(subject.old)))
				mr.write(subject.order, 0xa0, mr.uint32(0))
				log(('RESTORED the order of %s: place x back to %.2f'):format(subject.label, subject.old))
			else
				log(('order of %s NOT restored: it is gone or holds another place now (%s)'):format(subject.label, x and ('%.2f'):format(x) or 'gone'))
			end
		end
	end
end

-- start -----------------------------------------------------------------------------------------------------------

local function guarded(name, action)
	return function()
		if state.dead then return end
		local ok, problem = pcall(action)
		if not ok then
			give_up(name .. ': ' .. tostring(problem))
			pcall(function() bm:remove_callback(TIMER) end)
		end
	end
end

local function start()
	log('units order probe --VERSION-- TEST PACK, battle script loaded')
	mr = _G.memreader_plus
	if not mr then error('memreader Plus is not loaded', 0) end
	install()
	log(('memreader Plus %s, table at %s, order class %s'):format(tostring(mr.plus_version), hex(state.tbl), state.vtable))
	bm:register_phase_change_callback('Deployed', guarded('deployed', function()
		state.ticks = 0
		state.seen = mr.read_uint32(state.tbl, INDEX)
		log('fighting starts: let the units of your side STAND for 25 seconds')
	end))
	bm:repeat_callback(guarded('tick', function()
		if not state.ticks then return end
		state.ticks = state.ticks + 1
		local tick = state.ticks
		if tick == T_PICK then
			pick_subjects()
			state.orders, state.known = {}, 0 -- look at every order again now that the subjects are known
		end
		read_ring()
		if tick == T_PICK then report('first 3 s:') end
		if tick == T_REPORT then report('next 3 s:') end
		if tick == T_EDIT then
			report('until the edit:')
			edit()
		end
		if tick > T_EDIT and tick < T_END and tick % 5 == 0 then follow(('%d s'):format(tick * TICK_MS / 1000)) end
		if tick == T_RESTORE then restore() end
		if tick == T_END then
			report('since the edit:')
			log('PROBE FINISHED - you can leave the battle')
			state.dead = true
			pcall(function() bm:remove_callback(TIMER) end)
		end
	end), TICK_MS, TIMER)
end

local ok, problem = pcall(start)
if not ok then give_up(problem) end
