-- Units Pass Through "place probe", version --VERSION--: test pack (!units_place_probe_debug.pack).
-- Question: where does the game keep the place in the formation a standing model belongs to?
-- What it does, by itself, in the first minute of the fighting (the player's units must just STAND):
--    5 s  notes where a few models of standing units of the player's side stand, and searches the model and
--         its unit for those numbers
--    8 s  moves these models 4 m aside
--         then watches who tells them to walk back and where to, and which of the found numbers stayed
--   30 s  changes the best candidates for "the place" by 2.5 m, one after the other, and watches whether the
--         model walks there; puts the old number back each time
--   55 s  writes a summary: "PROBE FINISHED"
-- Needs memreader Plus. If anything does not match this game build, it does nothing.
-- Log: units_place_probe_log.txt in the game folder.

local MOD = 'units_place_probe'
local LOG_FILE = 'units_place_probe_log.txt'
local TIMER = MOD .. '_tick'
local TICK_MS = 200
local T_BASE, T_MOVE, T_AFTER, T_TRY, T_END = 25, 40, 41, 150, 275 -- ticks after the fighting starts
local TRY_TICKS = 25 -- one candidate is tried for 5 s
local SHIFT, TRY_SHIFT = 4.0, 2.5 -- metres
local MAX_UNITS, MAX_TRIES = 2, 4

-- generated by place_probe.py (do not edit by hand) -----------------------------------------------------------------
local SITE = { name = 'walk_to', hi = --HI--, lo = --LO--, sig = '--SIG--', tail = '--TAIL--' }
local HEAD = '--HEAD--'
local TABLE_SIZE = --TABLE_SIZE--
local INDEX, RING_AT, RING, ENTRY = --INDEX--, --RING_AT--, --RING--, --ENTRY--
local P_UID = '--P_UID--'
local UID_OFF = --UID_OFF--
-- end of generated part -------------------------------------------------------------------------------------------

local NEEDED = { 'find_pattern', 'hook_info', 'code_cave', 'game_alloc', 'alloc', 'read', 'read_original', 'write', 'read_pointer', 'read_uint32', 'read_float', 'ud_topointer', 'add', 'is_null', 'tostring', 'uint32' }
local MODEL_SIZE, UNIT_SIZE, DEEP_SIZE = 0xb40, 0x4800, 0x300

local mr = nil
local state = { dead = false, tbl = nil, uid_offset = nil, buffer = nil, started = false, ticks = nil, seen = 0, subjects = {}, by_model = {}, callers = {}, callers_subject = {}, candidates = {}, tries = {}, try = nil, lost = 0 }

local function log(message)
	local file = io.open(LOG_FILE, state.started and 'a' or 'w')
	state.started = true
	if not file then return end
	file:write(os.date('%H:%M:%S') .. ' ' .. tostring(message) .. '\n')
	file:close()
end

local function give_up(reason)
	state.dead = true
	log('PROBE OFF: ' .. tostring(reason))
end

local function raw8(pointer)
	state.buffer = state.buffer or mr.alloc(16)
	mr.write(state.buffer, 0, pointer)
	return mr.read(state.buffer, 0, 8)
end

local function hex(pointer)
	return mr.tostring(pointer)
end

-- the 32 bits of a float (the game's numbers are 4-byte floats; memreader writes 4 bytes through mr.uint32)
local function float_bits(x)
	if x == 0 then return 0 end
	local sign = 0
	if x < 0 then sign, x = 2147483648, -x end
	local m, e = math.frexp(x)
	local exponent = e + 126
	local fraction = math.floor((m * 2 - 1) * 8388608 + 0.5)
	if fraction == 8388608 then fraction, exponent = 0, exponent + 1 end
	return sign + exponent * 8388608 + fraction
end

local function write_float(pointer, offset, value)
	mr.write(pointer, offset, mr.uint32(float_bits(value)))
	local now = mr.read_float(pointer, offset)
	if math.abs(now - value) > 0.001 then error(('a written number reads back as %s instead of %s'):format(tostring(now), tostring(value)), 0) end
end

-- installing ------------------------------------------------------------------------------------------------------

local function install()
	for _, name in ipairs(NEEDED) do
		if type(mr[name]) ~= 'function' then error('this memreader has no ' .. name, 0) end
	end
	if not mr.base then error('this memreader does not tell where the game is loaded', 0) end
	local address, count = mr.find_pattern(P_UID)
	if not address or count ~= 1 then error('unit id code found ' .. tostring(count) .. ' times', 0) end
	state.uid_offset = mr.read_uint32(mr.add(address, UID_OFF), 0)
	if type(state.uid_offset) ~= 'number' or state.uid_offset < 8 or state.uid_offset > 0x100000 then error('implausible unit id offset', 0) end
	SITE.at = mr.add(mr.add(mr.base, SITE.hi * 65536), SITE.lo)
	if mr.read_original(SITE.at, 0, #SITE.sig) ~= SITE.sig then error('this game build is not the analysed one', 0) end
	local info = mr.hook_info(SITE.at)
	if info then
		if info.kind ~= 'cave' or not info.cave then error('something else hooks the routine', 0) end
		if mr.read(info.cave, #HEAD + 8, #SITE.tail) ~= SITE.tail then error('a cave of another version is in place: restart the game', 0) end
		state.tbl = mr.read_pointer(info.cave, #HEAD)
		if mr.is_null(state.tbl) then error('cave without a table', 0) end
		log('cave of an earlier battle of this session found, reusing it')
	else
		state.tbl = mr.game_alloc(TABLE_SIZE)
		local ok, problem = pcall(mr.code_cave, SITE.at, HEAD .. raw8(state.tbl) .. SITE.tail)
		if not ok then error('memreader refused the cave: ' .. tostring(problem), 0) end
		log('cave installed')
	end
	if float_bits(1) ~= 1065353216 or float_bits(-2.5) ~= 3223322624 or float_bits(0.1) ~= 1036831949 then error('float conversion is wrong', 0) end
	state.seen = mr.read_uint32(state.tbl, INDEX)
end

-- units and models --------------------------------------------------------------------------------------------------

local function unit_pointer(unit)
	local pointer = mr.read_pointer(mr.ud_topointer(unit), 8)
	if mr.is_null(pointer) or mr.read_uint32(pointer, state.uid_offset) ~= unit:unique_ui_id() then return nil end
	return pointer
end

local function position(model)
	return mr.read_float(model, 0x88), mr.read_float(model, 0x8c), mr.read_float(model, 0x90)
end

-- up to MAX_UNITS standing units of the first alliance with 20 or more foot models; 3 models of each
local function pick_subjects()
	local armies = bm.battle:alliances():item(1):armies()
	for b = 1, armies:count() do
		local list = armies:item(b):units()
		for index = 1, list:count() do
			local unit = list:item(index)
			local ok, pointer = pcall(unit_pointer, unit)
			if ok and pointer and #state.subjects < MAX_UNITS * 3 then
				local count = mr.read_uint32(pointer, 0xa4)
				local models = mr.read_pointer(pointer, 0xa8)
				local label = ('A1.%d.%d %s'):format(b, index, tostring(unit:type()))
				if count >= 20 and count <= 2000 and not mr.is_null(models) and unit:is_idle() and not unit:is_moving() then
					local first = mr.read_pointer(models, 0)
					if mr.read_uint32(first, 0x74) == 1 and hex(mr.read_pointer(first, 0x2e8)) == hex(pointer) then
						for n, place in ipairs({ 0, math.floor(count / 2), count - 1 }) do
							local model = mr.read_pointer(models, 8 * place)
							local subject = { unit = unit, unit_pointer = pointer, model = model, label = ('%s model %d'):format(label, place), calls = 0 }
							state.subjects[#state.subjects + 1] = subject
							state.by_model[hex(model)] = subject
						end
						log(('subject unit: %s, %d models, unit object %s'):format(label, count, hex(pointer)))
					end
				end
			end
		end
	end
	if #state.subjects == 0 then error('no standing unit of 20 or more foot models on the first side', 0) end
end

-- searching for the numbers of a place -----------------------------------------------------------------------------

-- every spot in size bytes from base where x stands and z stands 4 or 8 bytes later
local function scan(base, size, x, z, label, found, kind)
	for offset = 0, size - 12, 4 do
		local ok, value = pcall(mr.read_float, base, offset)
		if not ok then return end
		if value == value and math.abs(value - x) < 0.05 then
			for _, step in ipairs({ 4, 8 }) do
				local ok2, other = pcall(mr.read_float, base, offset + step)
				if ok2 and other == other and math.abs(other - z) < 0.05 then
					found[#found + 1] = { base = base, offset = offset, step = step, kind = kind, label = ('%s+0x%x (z %d bytes later)'):format(label, offset, step) }
				end
			end
		end
	end
end

-- the object itself and everything it points to directly
local function scan_deep(base, size, x, z, label, found)
	scan(base, size, x, z, label, found, label)
	local seen = {}
	for offset = 0, size - 8, 8 do
		local ok, pointer = pcall(mr.read_pointer, base, offset)
		if ok and not mr.is_null(pointer) then
			local key = hex(pointer)
			if not seen[key] and pcall(mr.read_float, pointer, 0) then
				seen[key] = true
				scan(pointer, DEEP_SIZE, x, z, ('[%s+0x%x]'):format(label, offset), found, label)
			end
		end
	end
end

local function search(subject)
	local started = os.clock()
	local found = {}
	scan_deep(subject.model, MODEL_SIZE, subject.x, subject.z, 'model', found)
	scan_deep(subject.unit_pointer, UNIT_SIZE, subject.x, subject.z, 'unit', found)
	log(('  search for %.2f / %.2f around %s: %d spots in %.0f ms'):format(subject.x, subject.z, subject.label, #found, (os.clock() - started) * 1000))
	return found
end

local function value_of(spot)
	local ok, x = pcall(mr.read_float, spot.base, spot.offset)
	local ok2, z = pcall(mr.read_float, spot.base, spot.offset + spot.step)
	if not (ok and ok2) then return nil end
	return x, z
end

-- the ring the cave fills -------------------------------------------------------------------------------------------

local function read_ring()
	local now = mr.read_uint32(state.tbl, INDEX)
	local new = now - state.seen
	if new < 0 then new = new + 4294967296 end
	if new > RING then
		state.lost = state.lost + (new - RING)
		new = RING
	end
	for n = now - new, now - 1 do
		local at = RING_AT + (n % RING) * ENTRY
		local caller = hex(mr.read_pointer(state.tbl, at))
		state.callers[caller] = (state.callers[caller] or 0) + 1
		local subject = state.by_model[hex(mr.read_pointer(state.tbl, at + 8))]
		if subject and state.ticks and state.ticks >= T_MOVE then
			state.callers_subject[caller] = (state.callers_subject[caller] or 0) + 1
			subject.calls = subject.calls + 1
			if subject.calls <= 4 then
				local f = {}
				for i = 0, 7 do f[#f + 1] = ('%.2f'):format(mr.read_float(state.tbl, at + 0x10 + 4 * i)) end
				local x, y, z = position(subject.model)
				log(('  WALK ORDER for %s from %s: target numbers %s | model now at %.2f %.2f %.2f, its old place %.2f %.2f %.2f'):format(
					subject.label, caller, table.concat(f, ' '), x, y, z, subject.x, subject.y, subject.z))
			end
		end
	end
	state.seen = now
end

local function histogram(counts)
	local rows = {}
	for text, count in pairs(counts) do rows[#rows + 1] = { text = text, count = count } end
	table.sort(rows, function(a, b) return a.count > b.count end)
	local parts = {}
	for index = 1, math.min(#rows, 12) do parts[#parts + 1] = rows[index].text .. ' x' .. rows[index].count end
	return #parts > 0 and table.concat(parts, ', ') or 'none'
end

-- the steps -----------------------------------------------------------------------------------------------------------

local function step_base()
	for _, subject in ipairs(state.subjects) do
		subject.x, subject.y, subject.z = position(subject.model)
		log(('place of %s (model %s): %.2f %.2f %.2f'):format(subject.label, hex(subject.model), subject.x, subject.y, subject.z))
	end
	state.candidates = search(state.subjects[1])
	for _, spot in ipairs(state.candidates) do log('    ' .. spot.label) end
	log('callers of "walk to" while everything stands: ' .. histogram(state.callers))
	state.callers = {}
end

local function step_move()
	for _, subject in ipairs(state.subjects) do
		write_float(subject.model, 0x88, subject.x + SHIFT)
	end
	log(('MOVED %d models %.1f m aside (x + %.1f)'):format(#state.subjects, SHIFT, SHIFT))
end

local function step_after()
	local subject = state.subjects[1]
	local x, y, z = position(subject.model)
	log(('right after the move: %s is at %.2f %.2f %.2f; the spots found before now hold:'):format(subject.label, x, y, z))
	for _, spot in ipairs(state.candidates) do
		local sx, sz = value_of(spot)
		spot.kept = sx and math.abs(sx - subject.x) < 0.05 and math.abs(sz - subject.z) < 0.05
		log(('    %s: %s'):format(spot.label, sx and ('%.2f / %.2f%s'):format(sx, sz, spot.kept and '  <- STILL THE OLD PLACE' or '') or 'unreadable'))
	end
	-- spots that hold the old place only now
	local again = search(subject)
	for _, spot in ipairs(again) do
		local known = false
		for _, old in ipairs(state.candidates) do
			if old.label == spot.label then known = true end
		end
		if not known then
			spot.kept = true
			state.candidates[#state.candidates + 1] = spot
			log('    new spot with the old place: ' .. spot.label)
		end
	end
	-- the spots to try later: those that kept the old place; unit spots first
	for _, wanted in ipairs({ 'unit', 'model' }) do
		for _, spot in ipairs(state.candidates) do
			local own_position = hex(spot.base) == hex(subject.model) and spot.offset == 0x88 -- where the model IS, not where it belongs
			if spot.kept and spot.kind == wanted and not own_position and #state.tries < MAX_TRIES then state.tries[#state.tries + 1] = spot end
		end
	end
	log(('%d spots will be tried at %d s'):format(#state.tries, T_TRY * TICK_MS / 1000))
end

local function follow()
	local parts = {}
	for _, subject in ipairs(state.subjects) do
		local x, _, z = position(subject.model)
		parts[#parts + 1] = ('%.1f'):format(math.sqrt((x - subject.x) ^ 2 + (z - subject.z) ^ 2))
	end
	log(('  distance of the models from their old places (m): %s | calls of "walk to" for them: %s'):format(table.concat(parts, ' '), histogram(state.callers_subject)))
end

local function try_step(tick)
	local subject = state.subjects[1]
	local number = math.floor((tick - T_TRY) / TRY_TICKS) + 1
	local phase = (tick - T_TRY) % TRY_TICKS
	local spot = state.tries[number]
	if not spot then return end
	if phase == 0 then
		local sx, sz = value_of(spot)
		if not sx then
			log(('TRY %d: %s is unreadable now, skipped'):format(number, spot.label))
			spot.skip = true
			return
		end
		spot.old = sx
		write_float(spot.base, spot.offset, sx + TRY_SHIFT)
		log(('TRY %d: %s changed from %.2f to %.2f'):format(number, spot.label, sx, sx + TRY_SHIFT))
	elseif not spot.skip and phase % 5 == 0 then
		local sx = value_of(spot)
		local x, _, z = position(subject.model)
		log(('  try %d after %d s: the spot holds %s, the model is at %.2f / %.2f (old place %.2f / %.2f)'):format(
			number, phase * TICK_MS / 1000, sx and ('%.2f'):format(sx) or '?', x, z, subject.x, subject.z))
	end
	if not spot.skip and phase == TRY_TICKS - 1 then
		local sx = value_of(spot)
		if sx and math.abs(sx - (spot.old + TRY_SHIFT)) < 0.05 then
			write_float(spot.base, spot.offset, spot.old)
			log(('  try %d: the number had stayed changed; put back to %.2f'):format(number, spot.old))
		else
			log(('  try %d: the game had already overwritten the number (%s)'):format(number, sx and ('%.2f'):format(sx) or '?'))
		end
	end
end

-- start -----------------------------------------------------------------------------------------------------------

local function guarded(name, action)
	return function()
		if state.dead then return end
		local ok, problem = pcall(action)
		if not ok then
			give_up(name .. ': ' .. tostring(problem))
			pcall(function() bm:remove_callback(TIMER) end)
		end
	end
end

local function start()
	log('units place probe --VERSION-- TEST PACK, battle script loaded')
	mr = _G.memreader_plus
	if not mr then error('memreader Plus is not loaded', 0) end
	install()
	log(('memreader Plus %s, table at %s'):format(tostring(mr.plus_version), hex(state.tbl)))
	bm:register_phase_change_callback('Deployed', guarded('deployed', function()
		state.ticks = 0
		log('fighting starts: let the units of your side STAND for one minute')
	end))
	bm:repeat_callback(guarded('tick', function()
		if not state.ticks then return end
		state.ticks = state.ticks + 1
		local tick = state.ticks
		read_ring()
		if tick == T_BASE then
			pick_subjects()
			step_base()
		elseif tick == T_MOVE then
			step_move()
		elseif tick == T_AFTER then
			step_after()
		end
		if tick > T_MOVE and tick < T_TRY and tick % 10 == 0 then follow() end
		if tick >= T_TRY and tick < T_END then try_step(tick) end
		if tick == T_END then
			log('all callers of "walk to" since the move: ' .. histogram(state.callers))
			log('callers for the moved models: ' .. histogram(state.callers_subject))
			log(('calls not seen because the ring was full: %d'):format(state.lost))
			log('PROBE FINISHED - you can leave the battle')
			state.dead = true
			pcall(function() bm:remove_callback(TIMER) end)
		end
	end), TICK_MS, TIMER)
end

local ok, problem = pcall(start)
if not ok then give_up(problem) end
