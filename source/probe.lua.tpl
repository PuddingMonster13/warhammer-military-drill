-- Units Pass Through probe, version --VERSION--: test pack (!units_pass_probe_debug.pack).
-- It records how the game handles models that touch each other and writes that to units_pass_probe_log.txt in the
-- game folder. ONE MODE PER BATTLE, by the number of the battle since the game was started:
--   battle 1  mode 0  nothing is changed, the probe only records
--   battle 2  mode 1  a model walking into a model of another friendly unit is not marked "blocked"
--   battle 3  mode 2  models of different friendly units are not picked as collision partners at all
--   battle 4  mode 0 again, and so on. The mode is on only while the fighting lasts.
-- Needs memreader Plus. If anything does not match this game build, it does nothing.

local MOD = 'units_pass_probe'
local LOG_FILE = 'units_pass_probe_log.txt'
local TIMER = MOD .. '_tick'
local TICK_MS = 200
local REPORT_EVERY = 25 -- ticks (5 s)
local UNITS_EVERY = 150 -- ticks (30 s)
local TOTALS_EVERY = 300 -- ticks (60 s)
local PHASE_NAMES = { [0] = 'mode 0: game unchanged', [1] = 'mode 1: friendly models of other units do not BLOCK', [2] = 'mode 2: friendly models of other units do not COLLIDE' }

-- generated by probe.py (do not edit by hand) -----------------------------------------------------------------------
local SITES = {
--SITES--
}
local HEAD = '--HEAD--'
local TABLE_SIZE = --TABLE_SIZE--
local MODE, BATTLES = --MODE--, --BATTLES--
local H_TOTAL, H_SAME, H_OTHER, H_ENEMY = --H_TOTAL--, --H_SAME--, --H_OTHER--, --H_ENEMY--
local H_RET_SAME, H_RET_OTHER, H_RET_ENEMY = --H_RET_SAME--, --H_RET_OTHER--, --H_RET_ENEMY--
local O1_COUNT, O1_RET, O2_COUNT, O2_RET = --O1_COUNT--, --O1_RET--, --O2_COUNT--, --O2_RET--
local B1, B2 = --B1--, --B2--
local B_SAME, B_OTHER, B_ENEMY, B_SKIP, B_A, B_B = --B_SAME--, --B_OTHER--, --B_ENEMY--, --B_SKIP--, --B_A--, --B_B--
local S3, S4, S5 = --S3--, --S4--, --S5--
local G_SAME, G_OTHER, G_SKIP = --G_SAME--, --G_OTHER--, --G_SKIP--
local P_UID = '--P_UID--'
local UID_OFF = --UID_OFF--
-- end of generated part -------------------------------------------------------------------------------------------

local NEEDED = { 'find_pattern', 'hook_info', 'code_cave', 'game_alloc', 'alloc', 'read', 'read_original', 'write', 'read_pointer', 'read_uint32', 'read_float', 'ud_topointer', 'add', 'is_null', 'tostring', 'uint32' }
local ZERO = '0000000000000000'
local sub = string.sub_lua or string.sub -- the game replaces string.sub with a UTF-8 version
-- counters shown in every report: label, table offset
local COUNTERS = {
	{ 'pairs handled', H_TOTAL }, { 'same unit', H_SAME }, { 'other friendly unit', H_OTHER }, { 'enemy', H_ENEMY },
	{ 'override 1', O1_COUNT }, { 'override 2', O2_COUNT },
	{ 'BLOCKED mover=A same unit', B1 + B_SAME }, { 'BLOCKED mover=A other friendly unit', B1 + B_OTHER }, { 'BLOCKED mover=A enemy', B1 + B_ENEMY }, { 'not marked (mode 1) A', B1 + B_SKIP },
	{ 'BLOCKED mover=B same unit', B2 + B_SAME }, { 'BLOCKED mover=B other friendly unit', B2 + B_OTHER }, { 'BLOCKED mover=B enemy', B2 + B_ENEMY }, { 'not marked (mode 1) B', B2 + B_SKIP },
	{ 'blocked site 3', S3 }, { 'blocked site 4', S4 }, { 'blocked site 5', S5 },
	{ 'partner gate same unit', G_SAME }, { 'partner gate other friendly unit', G_OTHER }, { 'not picked (mode 2)', G_SKIP },
}
local CALLERS = { { 'pair handler caller (same unit)', H_RET_SAME }, { 'pair handler caller (other friendly unit)', H_RET_OTHER }, { 'pair handler caller (enemy)', H_RET_ENEMY }, { 'override 1 caller', O1_RET }, { 'override 2 caller', O2_RET } }

local mr = nil
local state = { dead = false, tbl = nil, uid_offset = nil, buffer = nil, started = false, units = {}, by_pointer = {}, ticks = 0, fight_ticks = nil, mode = 0, battle = 1, battle_mode = 0, pending = {}, file_ready = false, seen = {}, detail = {}, last = {}, totals = {}, ammo = {} }

-- lines wait until it is known whether this is the first battle since the game was started (new file) or a later
-- one (the file is continued)
local function log(message)
	state.pending[#state.pending + 1] = os.date('%H:%M:%S') .. ' ' .. tostring(message) .. '\n'
	if not state.file_ready then return end
	local file = io.open(LOG_FILE, 'a')
	if not file then return end
	file:write(table.concat(state.pending))
	file:close()
	state.pending = {}
end

local function open_log(continue)
	if state.file_ready then return end
	if not continue then
		local file = io.open(LOG_FILE, 'w')
		if file then file:close() end
	end
	state.file_ready = true
end

local function set_mode(mode)
	if state.tbl then mr.write(state.tbl, MODE, mr.uint32(mode)) end
	state.mode = mode
end

local function give_up(reason)
	state.dead = true
	pcall(set_mode, 0)
	open_log(false)
	log('PROBE OFF: ' .. tostring(reason))
end

local function raw8(pointer)
	state.buffer = state.buffer or mr.alloc(16)
	mr.write(state.buffer, 0, pointer)
	return mr.read(state.buffer, 0, 8)
end

local function hex(pointer)
	return mr.tostring(pointer)
end

local function game_address(hi, lo)
	return mr.add(mr.add(mr.base, hi * 65536), lo)
end

-- installing ------------------------------------------------------------------------------------------------------

local function install()
	for _, name in ipairs(NEEDED) do
		if type(mr[name]) ~= 'function' then error('this memreader has no ' .. name, 0) end
	end
	if not mr.base then error('this memreader does not tell where the game is loaded', 0) end
	local address, count = mr.find_pattern(P_UID)
	if not address or count ~= 1 then error('unit id code found ' .. tostring(count) .. ' times', 0) end
	state.uid_offset = mr.read_uint32(mr.add(address, UID_OFF), 0)
	if type(state.uid_offset) ~= 'number' or state.uid_offset < 8 or state.uid_offset > 0x100000 then error('implausible unit id offset', 0) end

	-- every site must hold exactly the bytes of the analysed game build, otherwise nothing is installed at all
	for _, site in ipairs(SITES) do
		site.at = game_address(site.hi, site.lo)
		if mr.read_original(site.at, 0, #site.sig) ~= site.sig then error('this game build is not the analysed one (' .. site.name .. ')', 0) end
		if site.exit_at >= 0 then
			site.tail = sub(site.tail, 1, site.exit_at) .. raw8(game_address(site.exit_hi, site.exit_lo)) .. sub(site.tail, site.exit_at + 9)
		end
	end
	-- caves of an earlier battle of this game session are still there: they must be this version's, then reuse them
	for _, site in ipairs(SITES) do
		local info = mr.hook_info(site.at)
		if info then
			if info.kind ~= 'cave' or not info.cave then error('something else hooks ' .. site.name, 0) end
			if mr.read(info.cave, #HEAD + 8, #site.tail) ~= site.tail then error('the cave at ' .. site.name .. ' is from another probe version: restart the game', 0) end
			local tbl = mr.read_pointer(info.cave, #HEAD)
			if mr.is_null(tbl) then error('cave without a table at ' .. site.name, 0) end
			if state.tbl and hex(state.tbl) ~= hex(tbl) then error('caves with different tables', 0) end
			state.tbl = tbl
			site.installed = true
		end
	end
	if state.tbl then
		log('caves of an earlier battle of this session found, reusing them')
	else
		state.tbl = mr.game_alloc(TABLE_SIZE) -- zeroed; never freed, the caves stay for the game session
	end
	set_mode(0)
	-- the table lives as long as the game runs: it counts the battles
	local earlier = mr.read_uint32(state.tbl, BATTLES)
	mr.write(state.tbl, BATTLES, mr.uint32(earlier + 1))
	state.battle, state.battle_mode = earlier + 1, earlier % 3
	open_log(earlier > 0)
	log(('--- battle %d since the game was started: %s'):format(state.battle, PHASE_NAMES[state.battle_mode]))
	for _, site in ipairs(SITES) do
		if not site.installed then
			local ok, problem = pcall(mr.code_cave, site.at, HEAD .. raw8(state.tbl) .. site.tail)
			site.installed = ok
			log(('site %-16s %s'):format(site.name, ok and 'cave installed' or ('NOT installed: ' .. tostring(problem))))
		end
	end
	for _, counter in ipairs(COUNTERS) do state.last[counter[2]] = mr.read_uint32(state.tbl, counter[2]) end
end

-- units -------------------------------------------------------------------------------------------------------------

local function unit_pointer(unit)
	local pointer = mr.read_pointer(mr.ud_topointer(unit), 8)
	if mr.is_null(pointer) or mr.read_uint32(pointer, state.uid_offset) ~= unit:unique_ui_id() then return nil end
	return pointer
end

local function collect_units()
	local units, by_pointer = {}, {}
	local alliances = bm.battle:alliances()
	for a = 1, alliances:count() do
		local armies = alliances:item(a):armies()
		for b = 1, armies:count() do
			local list = armies:item(b):units()
			for index = 1, list:count() do
				local unit = list:item(index)
				local entry = { unit = unit, label = ('A%d.%d.%d %s'):format(a, b, index, tostring(unit:type())) }
				local ok, pointer = pcall(unit_pointer, unit)
				if ok and pointer then
					entry.pointer = pointer
					by_pointer[hex(pointer)] = entry
				end
				units[#units + 1] = entry
			end
		end
	end
	state.units, state.by_pointer = units, by_pointer
end

-- what the script interface says a unit is doing
local function unit_doing(entry)
	local parts = {}
	for _, name in ipairs({ 'is_moving', 'is_moving_fast', 'is_idle', 'is_in_melee', 'is_routing', 'is_under_missile_attack' }) do
		local ok, value = pcall(function() return entry.unit[name](entry.unit) end)
		if not ok then
			parts[#parts + 1] = (name:gsub('^is_', '')) .. '?'
		elseif value then
			parts[#parts + 1] = (name:gsub('^is_', ''))
		end
	end
	local ok, ammo = pcall(function() return entry.unit:ammo_left() end)
	if ok and type(ammo) == 'number' then
		local before = state.ammo[entry.label] -- entries are rebuilt now and then, the ammunition memory is not
		if before and ammo < before then parts[#parts + 1] = 'shooting' end
		state.ammo[entry.label] = ammo
	end
	return #parts > 0 and table.concat(parts, ',') or 'nothing'
end

-- the fields of a model that may tell whether it stands, walks or fights
local function model_fields(model)
	local vx, vz = mr.read_float(model, 0xe0), mr.read_float(model, 0xe8)
	return ('kind %d, radius %.2f, mass %.0f, speed %.2f, +0x23c %.2f, +0x104 %d, +0x318 %d, flags +0x6c %08x +0x70 %08x, +0x188 %08x, blocked byte %d'):format(
		mr.read_uint32(model, 0x74), mr.read_float(model, 0xa0), mr.read_float(model, 0xb4), math.sqrt(vx * vx + vz * vz), mr.read_float(model, 0x23c),
		mr.read_uint32(model, 0x104), mr.read_uint32(model, 0x318), mr.read_uint32(model, 0x6c), mr.read_uint32(model, 0x70), mr.read_uint32(model, 0x188),
		mr.read_uint32(model, 0x1b0) % 256)
end

local function owner_of(model)
	return state.by_pointer[hex(mr.read_pointer(model, 0x2e8))]
end

local function units_report()
	for _, entry in ipairs(state.units) do
		local ok, text = pcall(function()
			if not entry.pointer then return 'unit object not confirmed' end
			local head = ('men %s, unit: %s'):format(tostring(entry.unit:number_of_men_alive()), unit_doing(entry))
			local count = mr.read_uint32(entry.pointer, 0xa4)
			local list = mr.read_pointer(entry.pointer, 0xa8)
			if count < 1 or count > 2000 or mr.is_null(list) then return head .. ' | no model list' end
			local model = mr.read_pointer(list, 0)
			if hex(mr.read_pointer(model, 0x2e8)) ~= hex(entry.pointer) then return head .. ' | first model does not link back' end
			return head .. ' | first model: ' .. model_fields(model)
		end)
		log('  ' .. entry.label .. ': ' .. (ok and text or ('READ FAILED ' .. tostring(text))))
	end
end

-- sampling and reports ---------------------------------------------------------------------------------------------

local function note(key, text)
	state.seen[key] = state.seen[key] or {}
	state.seen[key][text] = (state.seen[key][text] or 0) + 1
end

-- several times a second: note what the caves saw last (they only keep the latest values)
local function sample()
	for _, caller in ipairs(CALLERS) do
		local text = hex(mr.read_pointer(state.tbl, caller[2]))
		if text ~= ZERO then note(caller[1], text) end
	end
	for index, base in ipairs({ B1, B2 }) do
		local a, b = mr.read_pointer(state.tbl, base + B_A), mr.read_pointer(state.tbl, base + B_B)
		if not mr.is_null(a) and not mr.is_null(b) then
			local key = hex(a) .. hex(b)
			if state.last['pair' .. index] ~= key then
				state.last['pair' .. index] = key
				local ok, short, long = pcall(function()
					local ua, ub = owner_of(a), owner_of(b)
					if not ua or not ub then return 'models of unknown units', nil end
					local da, db = unit_doing(ua), unit_doing(ub)
					return ('%s [%s] blocked by %s [%s]'):format(ua.label, da, ub.label, db),
						('mover %s [%s]: %s || blocker %s [%s]: %s'):format(ua.label, da, model_fields(a), ub.label, db, model_fields(b))
				end)
				note('friendly block', ok and short or ('READ FAILED ' .. tostring(short)))
				if ok and long then state.detail[index] = long end
			end
		end
	end
end

local function histogram(counts)
	local rows = {}
	for text, count in pairs(counts) do rows[#rows + 1] = { text = text, count = count } end
	table.sort(rows, function(x, y) return x.count > y.count end)
	local parts = {}
	for index = 1, math.min(#rows, 8) do parts[#parts + 1] = rows[index].text .. ' x' .. rows[index].count end
	return table.concat(parts, ' || ')
end

local function report(force)
	local parts = {}
	for _, counter in ipairs(COUNTERS) do
		local count = mr.read_uint32(state.tbl, counter[2])
		local delta = count - (state.last[counter[2]] or 0)
		if delta < 0 then delta = delta + 4294967296 end
		state.last[counter[2]] = count
		if delta ~= 0 then
			parts[#parts + 1] = ('%s +%d'):format(counter[1], delta)
			state.totals[counter[1]] = (state.totals[counter[1]] or 0) + delta
		end
	end
	if #parts == 0 and not force then
		state.seen, state.detail = {}, {}
		return
	end
	log(('[mode %d] %s'):format(state.mode, #parts > 0 and table.concat(parts, '; ') or 'no pairs handled'))
	local keys = {}
	for key in pairs(state.seen) do keys[#keys + 1] = key end
	table.sort(keys)
	for _, key in ipairs(keys) do log('  ' .. key .. ': ' .. histogram(state.seen[key])) end
	for index = 1, 2 do
		if state.detail[index] then log('  latest friendly block: ' .. state.detail[index]) end
	end
	state.seen, state.detail = {}, {}
end

local function totals_report(why)
	local parts = {}
	for _, counter in ipairs(COUNTERS) do
		if state.totals[counter[1]] then parts[#parts + 1] = ('%s %d'):format(counter[1], state.totals[counter[1]]) end
	end
	log(('=== totals so far, %s (%s): %s'):format(PHASE_NAMES[state.mode], why, #parts > 0 and table.concat(parts, '; ') or 'nothing'))
end

-- start -----------------------------------------------------------------------------------------------------------

local function guarded(name, action)
	return function()
		if state.dead then return end
		local ok, problem = pcall(action)
		if not ok then
			give_up(name .. ': ' .. tostring(problem))
			pcall(function() bm:remove_callback(TIMER) end)
		end
	end
end

local function start()
	log('units pass through probe --VERSION-- TEST PACK, battle script loaded')
	mr = _G.memreader_plus
	if not mr then error('memreader Plus is not loaded', 0) end
	install()
	log(('memreader Plus %s, table at %s, unit id offset 0x%x'):format(tostring(mr.plus_version), hex(state.tbl), state.uid_offset))
	bm:register_phase_change_callback('Deployed', guarded('deployed', function()
		collect_units()
		state.fight_ticks = 0
		set_mode(state.battle_mode)
		log('fighting starts, NOW ' .. PHASE_NAMES[state.battle_mode])
		log('units at battle start:')
		units_report()
	end))
	bm:repeat_callback(guarded('tick', function()
		state.ticks = state.ticks + 1
		if #state.units == 0 or state.ticks % UNITS_EVERY == 0 then collect_units() end
		sample()
		if state.fight_ticks then state.fight_ticks = state.fight_ticks + 1 end
		if state.ticks % REPORT_EVERY == 0 then report(false) end
		if state.fight_ticks and state.fight_ticks % TOTALS_EVERY == 0 then totals_report(('%d s of fighting'):format(state.fight_ticks * TICK_MS / 1000)) end
		if state.ticks % UNITS_EVERY == 0 then
			log('units now:')
			units_report()
		end
	end), TICK_MS, TIMER)
	bm:register_phase_change_callback('Complete', function()
		if state.dead then return end
		pcall(report, true)
		pcall(totals_report, 'battle ends')
		pcall(set_mode, 0)
		state.dead = true
		pcall(function() bm:remove_callback(TIMER) end)
		log('battle complete, game unchanged again')
	end)
end

local ok, problem = pcall(start)
if not ok then give_up(problem) end
