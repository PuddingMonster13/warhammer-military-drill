-- Units Pass Through "stack probe", version --VERSION--: test pack (!units_stack_probe_debug.pack).
-- Question: through which chain of game routines is a displaced infantry model sent back to its place?
-- By itself, in the first 20 s of the fighting (the player's units must just STAND):
--    3 s  picks six models of standing units of the player's side
--    8 s  moves them 4 m aside; then logs, for every "start move" of these models, the routines it came through
--   20 s  "PROBE FINISHED". Changes nothing else. Needs memreader Plus.
-- Log: units_stack_probe_log.txt in the game folder.

local MOD = 'units_stack_probe'
local LOG_FILE = 'units_stack_probe_log.txt'
local TIMER = MOD .. '_tick'
local TICK_MS = 200
local T_PICK, T_MOVE, T_END = 15, 40, 100 -- ticks after the fighting starts
local SHIFT = 4.0
local MAX_UNITS = 2
local OTHERS_PER_TICK = 12 -- calls for other models whose chain is looked at per tick

-- generated by stack_probe.py (do not edit by hand) -----------------------------------------------------------------
local SITE = { name = 'start_move', hi = --HI--, lo = --LO--, sig = '--SIG--', tail = '--TAIL--' }
local HEAD = '--HEAD--'
local TABLE_SIZE = --TABLE_SIZE--
local INDEX, RING_AT, RING, ENTRY, WORDS = --INDEX--, --RING_AT--, --RING--, --ENTRY--, --WORDS--
local IMAGE_HI = --IMAGE_HI--
local P_UID = '--P_UID--'
local UID_OFF = --UID_OFF--
-- end of generated part -------------------------------------------------------------------------------------------

local NEEDED = { 'find_pattern', 'hook_info', 'code_cave', 'game_alloc', 'alloc', 'read', 'read_original', 'write', 'read_pointer', 'read_uint32', 'read_float', 'ud_topointer', 'add', 'is_null', 'tostring', 'uint32' }
local sub = string.sub_lua or string.sub

local mr = nil
local state = { dead = false, tbl = nil, uid_offset = nil, buffer = nil, started = false, ticks = nil, seen = 0, lo = nil, hi = nil, subjects = {}, by_model = {},
	calls = 0, lost = 0, chains_subject = {}, chains_other = {} }

local function log(message)
	local file = io.open(LOG_FILE, state.started and 'a' or 'w')
	state.started = true
	if not file then return end
	file:write(os.date('%H:%M:%S') .. ' ' .. tostring(message) .. '\n')
	file:close()
end

local function give_up(reason)
	state.dead = true
	log('PROBE OFF: ' .. tostring(reason))
end

local function raw8(pointer)
	state.buffer = state.buffer or mr.alloc(16)
	mr.write(state.buffer, 0, pointer)
	return mr.read(state.buffer, 0, 8)
end

local function hex(pointer)
	return mr.tostring(pointer)
end

local function float_bits(x)
	if type(x) ~= 'number' or not (x > -1000000 and x < 1000000) then error('not a usable number: ' .. tostring(x), 0) end
	if x == 0 then return 0 end
	local sign = 0
	if x < 0 then sign, x = 2147483648, -x end
	local m, e = math.frexp(x)
	local exponent = e + 126
	local fraction = math.floor((m * 2 - 1) * 8388608 + 0.5)
	if fraction == 8388608 then fraction, exponent = 0, exponent + 1 end
	if exponent < 1 or exponent > 254 or fraction % 1 ~= 0 or fraction < 0 or fraction > 8388607 then error('not a usable number: ' .. tostring(x), 0) end
	return sign + exponent * 8388608 + fraction
end

local function get_float(pointer, offset)
	local exponent = math.floor(mr.read_uint32(pointer, offset) / 8388608) % 256
	if exponent == 255 then return nil end
	return mr.read_float(pointer, offset)
end

local function install()
	for _, name in ipairs(NEEDED) do
		if type(mr[name]) ~= 'function' then error('this memreader has no ' .. name, 0) end
	end
	if not mr.base then error('this memreader does not tell where the game is loaded', 0) end
	local address, count = mr.find_pattern(P_UID)
	if not address or count ~= 1 then error('unit id code found ' .. tostring(count) .. ' times', 0) end
	state.uid_offset = mr.read_uint32(mr.add(address, UID_OFF), 0)
	if type(state.uid_offset) ~= 'number' or state.uid_offset < 8 or state.uid_offset > 0x100000 then error('implausible unit id offset', 0) end
	if float_bits(1) ~= 1065353216 or float_bits(-2.5) ~= 3223322624 then error('float conversion is wrong', 0) end
	state.lo, state.hi = hex(mr.base), hex(mr.add(mr.base, IMAGE_HI * 65536))
	if #state.lo ~= 16 or #state.hi ~= 16 or not (state.lo < state.hi) then error('addresses do not print as 16 digits', 0) end
	SITE.at = mr.add(mr.add(mr.base, SITE.hi * 65536), SITE.lo)
	if mr.read_original(SITE.at, 0, #SITE.sig) ~= SITE.sig then error('this game build is not the analysed one', 0) end
	local info = mr.hook_info(SITE.at)
	if info then
		if info.kind ~= 'cave' or not info.cave then error('something else hooks the routine', 0) end
		if mr.read(info.cave, #HEAD + 8, #SITE.tail) ~= SITE.tail then error('a cave of another version is in place: restart the game', 0) end
		state.tbl = mr.read_pointer(info.cave, #HEAD)
		if mr.is_null(state.tbl) then error('cave without a table', 0) end
		log('cave of an earlier battle of this session found, reusing it')
	else
		state.tbl = mr.game_alloc(TABLE_SIZE)
		local ok, problem = pcall(mr.code_cave, SITE.at, HEAD .. raw8(state.tbl) .. SITE.tail)
		if not ok then error('memreader refused the cave: ' .. tostring(problem), 0) end
		log('cave installed')
	end
	state.seen = mr.read_uint32(state.tbl, INDEX)
end

local function unit_pointer(unit)
	local pointer = mr.read_pointer(mr.ud_topointer(unit), 8)
	if mr.is_null(pointer) or mr.read_uint32(pointer, state.uid_offset) ~= unit:unique_ui_id() then return nil end
	return pointer
end

local function position(model)
	return get_float(model, 0x88), get_float(model, 0x8c), get_float(model, 0x90)
end

local function pick_subjects()
	local armies = bm.battle:alliances():item(1):armies()
	for b = 1, armies:count() do
		local list = armies:item(b):units()
		for index = 1, list:count() do
			local unit = list:item(index)
			local ok, pointer = pcall(unit_pointer, unit)
			if ok and pointer and #state.subjects < MAX_UNITS * 3 then
				local count = mr.read_uint32(pointer, 0xa4)
				local models = mr.read_pointer(pointer, 0xa8)
				local label = ('A1.%d.%d %s'):format(b, index, tostring(unit:type()))
				if count >= 20 and count <= 2000 and not mr.is_null(models) and unit:is_idle() and not unit:is_moving() then
					local first = mr.read_pointer(models, 0)
					if mr.read_uint32(first, 0x74) == 1 and hex(mr.read_pointer(first, 0x2e8)) == hex(pointer) then
						for _, place in ipairs({ 0, math.floor(count / 2), count - 1 }) do
							local model = mr.read_pointer(models, 8 * place)
							local x, y, z = position(model)
							if x and y and z then
								local subject = { model = model, key = hex(model), label = ('%s model %d'):format(label, place), x = x, y = y, z = z, logged = 0 }
								state.subjects[#state.subjects + 1] = subject
								state.by_model[subject.key] = subject
							end
						end
						log(('subject unit: %s, %d models, class of its models %s'):format(label, count, hex(mr.read_pointer(first, 0))))
					end
				end
			end
		end
	end
	if #state.subjects == 0 then error('no standing unit of 20 or more foot models on the first side', 0) end
end

-- the stack words of a ring entry that point into the game's code, innermost first, as 7-digit addresses
local function chain_of(at)
	local parts = {}
	for i = 0, WORDS - 1 do
		local text = hex(mr.read_pointer(state.tbl, at + 0x18 + 8 * i))
		if text >= state.lo and text < state.hi then parts[#parts + 1] = sub(text, 10) end
	end
	return parts
end

local function read_ring()
	local now = mr.read_uint32(state.tbl, INDEX)
	local new = now - state.seen
	if new < 0 then new = new + 4294967296 end
	state.calls = state.calls + new
	if new > RING then
		state.lost = state.lost + (new - RING)
		new = RING
	end
	local others = 0
	for n = now - new, now - 1 do
		local at = RING_AT + (n % RING) * ENTRY
		local subject = state.by_model[hex(mr.read_pointer(state.tbl, at))]
		if subject and state.moved then
			local parts = chain_of(at)
			local short = table.concat(parts, ' < ', 1, math.min(#parts, 6))
			state.chains_subject[short] = (state.chains_subject[short] or 0) + 1
			subject.logged = subject.logged + 1
			if subject.logged <= 2 then
				local tx, tz = get_float(state.tbl, at + 8), get_float(state.tbl, at + 0x10)
				log(('  START MOVE for %s to %s / %s (it stood at %.2f / %.2f), came through: %s'):format(subject.label,
					tx and ('%.2f'):format(tx) or '?', tz and ('%.2f'):format(tz) or '?', subject.x, subject.z, table.concat(parts, ' < ')))
			end
		elseif others < OTHERS_PER_TICK then
			others = others + 1
			local parts = chain_of(at)
			local short = table.concat(parts, ' < ', 1, math.min(#parts, 4))
			state.chains_other[short] = (state.chains_other[short] or 0) + 1
		end
	end
	state.seen = now
end

local function histogram(counts)
	local rows = {}
	for text, count in pairs(counts) do rows[#rows + 1] = { text = text, count = count } end
	table.sort(rows, function(a, b) return a.count > b.count end)
	local parts = {}
	for index = 1, math.min(#rows, 8) do parts[#parts + 1] = ('x%d: %s'):format(rows[index].count, rows[index].text) end
	return #parts > 0 and table.concat(parts, ' || ') or 'none'
end

local function report(title)
	log(('%s "start move" ran %d times (%d not seen, ring full)'):format(title, state.calls, state.lost))
	log('  chains for other models: ' .. histogram(state.chains_other))
	log('  chains for the moved models: ' .. histogram(state.chains_subject))
	state.calls, state.lost, state.chains_other, state.chains_subject = 0, 0, {}, {}
end

local function guarded(name, action)
	return function()
		if state.dead then return end
		local ok, problem = pcall(action)
		if not ok then
			give_up(name .. ': ' .. tostring(problem))
			pcall(function() bm:remove_callback(TIMER) end)
		end
	end
end

local function start()
	log('units stack probe --VERSION-- TEST PACK, battle script loaded')
	mr = _G.memreader_plus
	if not mr then error('memreader Plus is not loaded', 0) end
	install()
	log(('memreader Plus %s, table at %s, game code from %s to %s'):format(tostring(mr.plus_version), hex(state.tbl), state.lo, state.hi))
	bm:register_phase_change_callback('Deployed', guarded('deployed', function()
		state.ticks = 0
		state.seen = mr.read_uint32(state.tbl, INDEX)
		log('fighting starts: let the units of your side STAND for 20 seconds')
	end))
	bm:repeat_callback(guarded('tick', function()
		if not state.ticks then return end
		state.ticks = state.ticks + 1
		local tick = state.ticks
		if tick == T_PICK then pick_subjects() end
		read_ring()
		if tick == T_MOVE then
			report(('the first %d s, everything stands:'):format(T_MOVE * TICK_MS / 1000))
			for _, subject in ipairs(state.subjects) do
				mr.write(subject.model, 0x88, mr.uint32(float_bits(subject.x + SHIFT)))
			end
			state.moved = true
			log(('MOVED %d models %.1f m aside'):format(#state.subjects, SHIFT))
		elseif tick == T_END then
			local parts = {}
			for _, subject in ipairs(state.subjects) do
				local x, _, z = position(subject.model)
				parts[#parts + 1] = (x and z) and ('%.1f'):format(math.sqrt((x - subject.x) ^ 2 + (z - subject.z) ^ 2)) or '?'
			end
			log('distance of the moved models from their places now (m): ' .. table.concat(parts, ' '))
			report(('the %d s after the move:'):format((T_END - T_MOVE) * TICK_MS / 1000))
			log('PROBE FINISHED - you can leave the battle')
			state.dead = true
			pcall(function() bm:remove_callback(TIMER) end)
		end
	end), TICK_MS, TIMER)
end

local ok, problem = pcall(start)
if not ok then give_up(problem) end
