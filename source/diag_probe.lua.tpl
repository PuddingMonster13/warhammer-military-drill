-- Units Pass Through - "diagnostic probe" --VERSION-- (!units_diag_probe_debug.pack), test pack.
-- Runs next to the lanes test build and only WATCHES (it writes nothing into the game). One battle answers:
--   1. a MARCHING unit: which game routines give its models their places while it moves;
--   2. sizes: what the models of every unit are (kind, radius, mass, sub-models) - big monsters, cavalry, artillery;
--   3. a STANDING unit that opens lanes: what its models do with the place they were sent to (cavalry!);
--   4. a moving war machine: what it consists of (part of 2).
-- Log: units_diag_probe_log.txt in the game folder. Only the player's side (alliance 1) is watched.

local LOG_FILE = 'units_diag_probe_log.txt'
local TIMER = 'units_diag_probe_tick'
local TICK_MS = 200
local MOVE_TICKS = 50 -- a marching unit is watched for its first 10 s
local OPEN_TICKS = 25 -- a unit that opened lanes is watched for 5 s
local MAX_MOVE_WATCHES = 16 -- the automatic scenario walks 7 times; teleports may count too
local MAX_OPEN_WATCHES = 12 -- and at most 4 per kind of unit (infantry, cavalry, monster, artillery)
local MODELS_PER_WATCH = 3
local IMAGE_HI = --IMAGE_HI--
local FLAGS = { 'is_infantry', 'is_cavalry', 'is_war_beasts', 'is_chariot', 'is_elephants', 'is_artillery', 'is_war_machine', 'can_fly' }
-- the lanes test build 0.6 (read only): its table is found through its cave 1 (the same pattern as in the lanes build)
local LANES_SITE = --LANES_SITE--
local L_LIST, L_ENTRY, L_L, L_PENDING, L_MAX = 0x80, 0xb0, 0x1c, 0x9c, 120

-- generated by diag_probe.py (do not edit by hand) -----------------------------------------------------------------
local SITES = {
--SITES--
}
local RINGS = {
--RINGS--
}
local COUNTERS = {
--COUNTERS--
}
local WORDS = --WORDS--
local HEAD = '--HEAD--'
local TABLE_SIZE = --TABLE_SIZE--
local P_UID = '--P_UID--'
local UID_OFF = --UID_OFF--
-- end of generated part -------------------------------------------------------------------------------------------

--FIND_SITE--

local NEEDED = { 'find_pattern', 'hook_info', 'code_cave', 'game_alloc', 'alloc', 'read', 'read_original', 'write', 'read_pointer', 'read_uint32', 'read_float', 'ud_topointer', 'add', 'is_null', 'tostring' }
local sub = string.sub_lua or string.sub
local mr = nil
local state = { dead = false, started = false, tbl = nil, lanes = nil, units = {}, known = {}, watches = {}, watched = {}, moves = 0, opens = 0, per_kind = {},
	seen = {}, calls = {}, lost = {}, counts = {}, ticks = 0, fighting = false }

local function log(message)
	local file = io.open(LOG_FILE, state.started and 'a' or 'w')
	state.started = true
	if not file then return end
	file:write(os.date('%H:%M:%S') .. ' ' .. tostring(message) .. '\n')
	file:close()
end

local function hex(pointer)
	return mr.tostring(pointer)
end

local function raw8(pointer)
	state.buffer = state.buffer or mr.alloc(16)
	mr.write(state.buffer, 0, pointer)
	return mr.read(state.buffer, 0, 8)
end

-- a float of the game, or nil when it is not an ordinary number (the game's Lua compares NaN wrongly)
local function get_float(pointer, offset)
	local exponent = math.floor(mr.read_uint32(pointer, offset) / 8388608) % 256
	if exponent == 255 then return nil end
	local value = mr.read_float(pointer, offset)
	if not (value > -1000000 and value < 1000000) then return nil end
	return value
end

local function f1(value)
	return value and ('%.1f'):format(value) or '?'
end

local function f2(value)
	return value and ('%.2f'):format(value) or '?'
end

-- a pointer into the game's code as a 7-digit address, or nil
local function code(pointer)
	local text = hex(pointer)
	if text >= state.lo and text < state.hi then return sub(text, 10) end
	return nil
end

local function byte_at(pointer, offset)
	return math.floor(mr.read_uint32(pointer, offset - offset % 4) / 256 ^ (offset % 4)) % 256
end

local function yes(unit, method)
	local ok, value = pcall(function() return unit[method](unit) end)
	return ok and value == true
end

-- installing ------------------------------------------------------------------------------------------------------

local function install()
	for _, name in ipairs(NEEDED) do
		if type(mr[name]) ~= 'function' then error('this memreader has no ' .. name, 0) end
	end
	local address, count = mr.find_pattern(P_UID)
	if not address or count ~= 1 then error('unit id code found ' .. tostring(count) .. ' times', 0) end
	state.uid_offset = mr.read_uint32(mr.add(address, UID_OFF), 0)
	state.lo, state.hi = hex(mr.base), hex(mr.add(mr.base, IMAGE_HI * 65536))
	if state.lo ~= '0000000140000000' then log('NOTE: the game is not loaded at 0000000140000000; code addresses below are not rva') end
	for _, site in ipairs(SITES) do site.at = find_site(mr, site) end
	state.lanes_at = find_site(mr, LANES_SITE)
	local found = 0
	for _, site in ipairs(SITES) do
		site.info = mr.hook_info(site.at)
		if site.info then
			if site.info.kind ~= 'cave' or not site.info.cave or mr.read(site.info.cave, #HEAD + 8, #site.tail) ~= site.tail then error('something else hooks ' .. site.name .. ': restart the game', 0) end
			local tbl = mr.read_pointer(site.info.cave, #HEAD)
			if state.tbl and hex(tbl) ~= hex(state.tbl) then error('caves without a common table: restart the game', 0) end
			state.tbl = tbl
			found = found + 1
		end
	end
	if found == 0 then state.tbl = mr.game_alloc(TABLE_SIZE) end
	for _, site in ipairs(SITES) do
		if not site.info then
			local ok, problem = pcall(mr.code_cave, site.at, HEAD .. raw8(state.tbl) .. site.tail)
			if not ok then error('memreader refused the cave ' .. site.name .. ': ' .. tostring(problem), 0) end
		end
	end
	for name, ring in pairs(RINGS) do state.seen[name], state.calls[name], state.lost[name] = mr.read_uint32(state.tbl, ring.index), 0, 0 end
	for name, at in pairs(COUNTERS) do state.counts[name] = mr.read_uint32(state.tbl, at) end
	log(('%d caves installed, %d reused; table at %s'):format(#SITES - found, found, hex(state.tbl)))
end

local function find_lanes()
	local info = mr.hook_info(state.lanes_at)
	if not info or info.kind ~= 'cave' or not info.cave then return nil end
	local tbl = mr.read_pointer(info.cave, #HEAD)
	if mr.is_null(tbl) then return nil end
	return tbl
end

-- units -------------------------------------------------------------------------------------------------------------

local function models_of(entry)
	local count = mr.read_uint32(entry.pointer, 0xa4)
	local models = mr.read_pointer(entry.pointer, 0xa8)
	if count < 1 or count > 2000 or mr.is_null(models) then return nil end
	return count, models
end

local function vtable(model)
	return code(mr.read_pointer(model, 0)) or hex(mr.read_pointer(model, 0))
end

-- what a unit is made of: one line per kind of model in its list, plus the sub-models of its first model
local function describe(entry)
	local unit = entry.unit
	local flags = {}
	for _, method in ipairs(FLAGS) do
		if yes(unit, method) then flags[#flags + 1] = method end
	end
	local ok, class = pcall(function() return unit:unit_class() end)
	local parts = { ('UNIT %s: %d men, ordered width %s, %s, class %s'):format(entry.label, unit:number_of_men_alive(), f1(unit:ordered_width()),
		#flags > 0 and table.concat(flags, ' ') or 'no flags', ok and tostring(class) or '?') }
	local count, models = models_of(entry)
	if not count then
		parts[#parts + 1] = 'model list not readable'
	else
		local groups, order = {}, {}
		for index = 0, count - 1 do
			local model = mr.read_pointer(models, index * 8)
			if not mr.is_null(model) then
				local key = vtable(model) .. ' kind ' .. mr.read_uint32(model, 0x74)
				local g = groups[key]
				if not g then
					g = { n = 0, rmin = 1e9, rmax = -1e9, height = get_float(model, 0x9c), mass = get_float(model, 0xb4) }
					groups[key] = g
					order[#order + 1] = key
				end
				g.n = g.n + 1
				local radius = get_float(model, 0xa0)
				if radius then
					g.rmin, g.rmax = math.min(g.rmin, radius), math.max(g.rmax, radius)
				end
			end
		end
		parts[#parts + 1] = ('list of %d'):format(count)
		for _, key in ipairs(order) do
			local g = groups[key]
			parts[#parts + 1] = ('%d x class %s: radius %s..%s, height %s, mass %s'):format(g.n, key, f2(g.rmin < 1e9 and g.rmin or nil), f2(g.rmax > -1e9 and g.rmax or nil), f2(g.height), f1(g.mass))
		end
		local first = mr.read_pointer(models, 0)
		local more = { ('first model %s: +0x2e0 %s, own unit %s'):format(hex(first), hex(mr.read_pointer(first, 0x2e0)), hex(mr.read_pointer(first, 0x2e8)) == hex(entry.pointer) and 'yes' or 'NO') }
		local okay, text = pcall(function()
			local n, list = mr.read_uint32(first, 0xb64), mr.read_pointer(first, 0xb68)
			if n < 1 or n > 16 or mr.is_null(list) then return ('+0xb64 = %d (no sub-models)'):format(n) end
			local subs = {}
			for i = 0, n - 1 do
				local s = mr.read_pointer(list, i * 8)
				if not mr.is_null(s) then
					subs[#subs + 1] = ('%s class %s kind %d radius %s height %s mass %s unit %s'):format(hex(s), vtable(s), mr.read_uint32(s, 0x74), f2(get_float(s, 0xa0)), f2(get_float(s, 0x9c)),
						f1(get_float(s, 0xb4)), hex(mr.read_pointer(s, 0x2e8)) == hex(entry.pointer) and 'same' or 'other')
				end
			end
			return ('%d sub-models: %s'):format(n, table.concat(subs, '; '))
		end)
		more[#more + 1] = okay and text or 'sub-models not readable'
		parts[#parts + 1] = table.concat(more, ', ')
	end
	log(table.concat(parts, ' | '))
end

local function unit_pointer(unit)
	local pointer = mr.read_pointer(mr.ud_topointer(unit), 8)
	if mr.is_null(pointer) or mr.read_uint32(pointer, state.uid_offset) ~= unit:unique_ui_id() then return nil end
	return pointer
end

local function kind_of(entry)
	local unit = entry.unit
	if yes(unit, 'is_artillery') or yes(unit, 'is_war_machine') then return 'artillery' end
	if yes(unit, 'is_cavalry') or yes(unit, 'is_chariot') then return 'cavalry' end
	if unit:number_of_men_alive() <= 3 or yes(unit, 'is_war_beasts') or yes(unit, 'is_elephants') then return 'monster' end
	return 'infantry'
end

local function collect_units()
	local armies = bm.battle:alliances():item(1):armies()
	for b = 1, armies:count() do
		local list = armies:item(b):units()
		for index = 1, list:count() do
			local unit = list:item(index)
			local ok, pointer = pcall(unit_pointer, unit)
			if ok and pointer and not state.known[hex(pointer)] then
				local entry = { unit = unit, pointer = pointer, key = hex(pointer), label = ('A1.%d.%d %s'):format(b, index, tostring(unit:type())), moving = false, lane = 0 }
				entry.kind = kind_of(entry)
				state.known[entry.key] = entry
				state.units[#state.units + 1] = entry
				local fine, problem = pcall(describe, entry)
				if not fine then log('UNIT ' .. entry.label .. ': ' .. tostring(problem)) end
			end
		end
	end
	-- where each unit sits in the lanes table
	state.lanes = state.lanes or find_lanes()
	if state.lanes then
		for slot = 0, L_MAX - 1 do
			local at = L_LIST + L_ENTRY * slot
			local pointer = mr.read_pointer(state.lanes, at)
			if mr.is_null(pointer) then break end
			local entry = state.known[hex(pointer)]
			if entry then entry.lanes_at = at end
		end
	end
end

-- watching ----------------------------------------------------------------------------------------------------------

local function pick_models(entry)
	local count, models = models_of(entry)
	if not count then return {} end
	local picked, seen = {}, {}
	for _, index in ipairs({ 0, math.floor(count / 2), count - 1 }) do
		if #picked < MODELS_PER_WATCH and not seen[index] then
			seen[index] = true
			local model = mr.read_pointer(models, index * 8)
			if not mr.is_null(model) then picked[#picked + 1] = { model = model, key = hex(model), name = 'model ' .. index, ev = {}, rets = {}, chains = {} } end
		end
	end
	return picked
end

local function start_watch(entry, kind, ticks, why)
	local watch = { entry = entry, kind = kind, left = ticks, models = pick_models(entry), formation = 0, chains = {}, rets = {} }
	for _, m in ipairs(watch.models) do
		m.watch = watch
		state.watched[m.key] = m
	end
	state.watches[#state.watches + 1] = watch
	log(('WATCH %s %s (%s): %s'):format(kind, entry.label, entry.kind, why))
	return watch
end

local function count_in(map, key)
	map[key] = (map[key] or 0) + 1
end

local function top(counts, limit)
	local rows = {}
	for text, count in pairs(counts) do rows[#rows + 1] = { text = text, count = count } end
	table.sort(rows, function(a, b) return a.count > b.count end)
	local parts = {}
	for index = 1, math.min(#rows, limit or 6) do parts[#parts + 1] = ('x%d: %s'):format(rows[index].count, rows[index].text) end
	return #parts > 0 and table.concat(parts, ' || ') or 'none'
end

-- new entries of every ring: what happened to the watched models
local function read_rings()
	for name, ring in pairs(RINGS) do
		local now = mr.read_uint32(state.tbl, ring.index)
		local new = (now - state.seen[name]) % 4294967296
		state.calls[name] = state.calls[name] + new
		if new > ring.slots then
			state.lost[name] = state.lost[name] + new - ring.slots
			new = ring.slots
		end
		for n = now - new, now - 1 do
			local at = ring.at + (n % ring.slots) * ring.size
			local m = state.watched[hex(mr.read_pointer(state.tbl, at + 8))]
			if m then
				local back = code(mr.read_pointer(state.tbl, at)) or '?'
				m.ev[name] = (m.ev[name] or 0) + 1
				m.rets[name] = m.rets[name] or {}
				count_in(m.rets[name], back)
				if ring.extra ~= 'stack' then -- start_move and walk_to: where to
					m.targets = m.targets or {}
					m.targets[name] = { get_float(state.tbl, at + 0x10), get_float(state.tbl, at + 0x18) }
				end
				if ring.stack then
					local parts = { back }
					for i = 0, WORDS - 1 do
						local c = code(mr.read_pointer(state.tbl, at + ring.stack + 8 * i))
						if c then parts[#parts + 1] = c end
					end
					m.watch.chains[name] = m.watch.chains[name] or {}
					count_in(m.watch.chains[name], table.concat(parts, ' < ', 1, math.min(#parts, 7)))
				end
			end
		end
		state.seen[name] = now
	end
end

local function position(model)
	return get_float(model, 0x88), get_float(model, 0x90)
end

local function events(m)
	local parts = {}
	for _, name in ipairs({ 'start_move', 'walk_to', 'order_390' }) do
		if m.ev[name] then parts[#parts + 1] = ('%s %d (from %s)'):format(name, m.ev[name], top(m.rets[name], 3)) end
	end
	m.ev, m.rets = {}, {}
	return #parts > 0 and table.concat(parts, ', ') or 'no calls'
end

-- one line per watched model: where it is, where it was last sent, and (for a unit that opened lanes) its station
local function model_line(watch, m)
	local x, z = position(m.model)
	local text = ('  %s %s: at %s / %s'):format(watch.entry.label, m.name, f2(x), f2(z))
	for _, name in ipairs({ 'start_move', 'walk_to' }) do
		local t = (m.targets or {})[name]
		if t and x and z and t[1] and t[2] then
			text = text .. (', last %s to %s / %s = %.1f m away'):format(name, f2(t[1]), f2(t[2]), math.sqrt((t[1] - x) ^ 2 + (t[2] - z) ^ 2))
		end
	end
	if watch.kind == 'OPEN' then
		local model = m.model
		text = text .. (' | station %s / %s, gate %d, flags %d %d %d, action %d %d, 6f8 %d, 600 %d, 8b0 %d, 324 %d'):format(f2(get_float(model, 0x858)), f2(get_float(model, 0x860)),
			mr.read_uint32(model, 0x884), byte_at(model, 0x888), byte_at(model, 0x889), byte_at(model, 0x88a), byte_at(model, 0x5c0), byte_at(model, 0x5c1),
			byte_at(model, 0x6f8), byte_at(model, 0x600), mr.read_uint32(model, 0x8b0), mr.read_uint32(model, 0x324))
	end
	return text .. ' | ' .. events(m)
end

local function end_watch(watch)
	for name, chains in pairs(watch.chains) do
		log(('  END %s %s: %s chains: %s'):format(watch.kind, watch.entry.label, name, top(chains, 8)))
	end
	for _, m in ipairs(watch.models) do
		if state.watched[m.key] == m then state.watched[m.key] = nil end
	end
end

local function update()
	-- who started to move, whose lanes opened
	for _, entry in ipairs(state.units) do
		local moving = entry.unit:is_moving()
		if moving and not entry.moving and state.moves < MAX_MOVE_WATCHES then
			state.moves = state.moves + 1
			local g = entry.unit:ordered_position()
			local p = entry.unit:position()
			start_watch(entry, 'MOVE', MOVE_TICKS, ('it starts to move from %s / %s to %s / %s, ordered width %s, bearing %s'):format(f1(p:get_x()), f1(p:get_z()),
				f1(g:get_x()), f1(g:get_z()), f1(entry.unit:ordered_width()), f1(entry.unit:ordered_bearing())))
		end
		entry.moving = moving
		if state.lanes and entry.lanes_at then
			local lane = get_float(state.lanes, entry.lanes_at + L_L) or 0
			if lane > 0 and entry.lane == 0 and state.opens < MAX_OPEN_WATCHES and (state.per_kind[entry.kind] or 0) < 4 then
				state.opens = state.opens + 1
				state.per_kind[entry.kind] = (state.per_kind[entry.kind] or 0) + 1
				start_watch(entry, 'OPEN', OPEN_TICKS, ('it opens lanes of %.1f m; jobs pending %d'):format(lane, mr.read_uint32(state.lanes, entry.lanes_at + L_PENDING)))
			end
			entry.lane = lane
		end
	end
	read_rings()
	local second = state.ticks % 5 == 0
	local formation = 0
	if second then
		local now = mr.read_uint32(state.tbl, COUNTERS.formation)
		formation = (now - state.counts.formation) % 4294967296
		state.counts.formation = now
	end
	local still = {}
	for _, watch in ipairs(state.watches) do
		watch.left = watch.left - 1
		if watch.kind == 'OPEN' or second then
			if watch.kind == 'MOVE' then
				local p, g = watch.entry.unit:position(), watch.entry.unit:ordered_position()
				log(('  %s: unit at %s / %s, ordered %s / %s, moving %s; formation routine ran %d times in the last second (all units)'):format(watch.entry.label, f1(p:get_x()), f1(p:get_z()),
					f1(g:get_x()), f1(g:get_z()), tostring(watch.entry.unit:is_moving()), formation))
			end
			for _, m in ipairs(watch.models) do
				local ok, text = pcall(model_line, watch, m)
				log(ok and text or ('  ' .. m.name .. ': ' .. tostring(text)))
			end
		end
		if watch.left <= 0 then end_watch(watch) else still[#still + 1] = watch end
	end
	state.watches = still
	if state.ticks % 50 == 0 then
		local parts = {}
		for name in pairs(RINGS) do parts[#parts + 1] = ('%s %d (lost %d)'):format(name, state.calls[name], state.lost[name]); state.calls[name], state.lost[name] = 0, 0 end
		local loop = mr.read_uint32(state.tbl, COUNTERS.form_loop)
		parts[#parts + 1] = ('formation loop %d'):format((loop - state.counts.form_loop) % 4294967296)
		state.counts.form_loop = loop
		log('calls in the last 10 s, all units: ' .. table.concat(parts, ', '))
	end
end

-- start -----------------------------------------------------------------------------------------------------------

local function guarded(name, action)
	return function()
		if state.dead then return end
		local ok, problem = pcall(action)
		if not ok then
			state.dead = true
			log('PROBE OFF: ' .. name .. ': ' .. tostring(problem))
			pcall(function() bm:remove_callback(TIMER) end)
		end
	end
end

local function start()
	log('units diag probe --VERSION-- TEST PACK, battle script loaded')
	mr = _G.memreader_plus
	if not mr then error('memreader Plus is not loaded', 0) end
	install()
	bm:register_phase_change_callback('Deployed', guarded('deployed', function()
		collect_units()
		state.fighting = true
		log(('fighting starts: %d units of your side; lanes test build %s'):format(#state.units, state.lanes and ('found, table at ' .. hex(state.lanes)) or 'NOT found (no OPEN watches)'))
	end))
	bm:repeat_callback(guarded('tick', function()
		if not state.fighting then return end
		state.ticks = state.ticks + 1
		if state.ticks % 50 == 0 then collect_units() end
		update()
	end), TICK_MS, TIMER)
	bm:register_phase_change_callback('Complete', function()
		state.dead = true
		pcall(function() bm:remove_callback(TIMER) end)
		log(('battle complete: %d MOVE and %d OPEN watches. PROBE FINISHED'):format(state.moves, state.opens))
	end)
end

local ok, problem = pcall(start)
if not ok then
	state.dead = true
	log('PROBE OFF: ' .. tostring(problem))
end
